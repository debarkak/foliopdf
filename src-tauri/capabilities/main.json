{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Open and read files selected in the native file dialog.",
  "windows": ["main"],
  "permissions": [
    "core:default", "core:window:allow-start-dragging", "core:window:allow-minimize",
    "core:window:allow-toggle-maximize", "core:window:allow-close", "dialog:allow-open", "fs:allow-read-file",
    "updater:default", "process:allow-restart",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://github.com/debarkak/foliopdf/releases/latest" }] }
  ]
}
