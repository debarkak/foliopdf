{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Open and read files selected in the native file dialog.",
  "windows": ["main"],
  "permissions": [
    "core:default", "dialog:allow-open", "fs:allow-read-file",
    "updater:default", "process:allow-restart",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://github.com/debarkak/foliopdf/releases/latest" }, { "url": "https://github.com/debarkak/foliopdf/blob/main/docs/user-guide.md" }] }
  ]
}
