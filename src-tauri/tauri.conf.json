{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FolioPDF",
  "version": "1.0.15",
  "identifier": "io.github.debarkak.foliopdf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "FolioPDF",
      "width": 1080,
      "height": 760,
      "minWidth": 460,
      "minHeight": 360,
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' blob: data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "deb", "appimage"],
    "shortDescription": "A lightweight PDF reader",
    "longDescription": "Read local PDFs with selectable text, vertical scrolling, page navigation and zoom.",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "resources": { "../public/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt" },
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwMTk2NTNBRTU5NUQ5QkEKUldTNjJaWGxPbVVad09YbVNaOUdHQmJ1V0RiNE5Bc3hNa2gwWHhtY3J2K2hXOURKK0o5a0VldmkK",
      "endpoints": ["https://github.com/debarkak/foliopdf/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
